{
  "name": "meeting-copilot-research",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "AI Meeting Copilot — Research & Analysis Viewer",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && cp -r public/docs dist/docs && cp public/publish.json dist/ && cp public/project-manifest.json dist/ && cp public/login.html dist/ 2>/dev/null || true",
    "build:full": "node scripts/generate-publish-manifest.js --all-projects && vite build && node scripts/copy-project-content.js",
    "generate-manifest": "node scripts/generate-publish-manifest.js --all-projects",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "web-publishing",
    "documentation",
    "dashboards",
    "meeting-copilot",
    "markdown-viewer"
  ],
  "author": "Meeting Copilot Team",
  "license": "UNLICENSED",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.564.0",
    "mermaid": "^11.12.2",
    "minisearch": "^7.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
